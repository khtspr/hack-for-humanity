{
  "name": "homematch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:transit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --max-old-space-size=4096 scripts/build-transit.mjs",
    "build:amenities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/fetch-amenities.mjs",
    "prepare-data": "npm run build:transit && npm run build:amenities"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "14.2.30",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.17.30",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
