{
  "name": "homematch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:transit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --max-old-space-size=4096 scripts/build-transit.mjs",
    "build:amenities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/fetch-amenities.mjs",
    "prepare-data": "npm run build:transit && npm run build:amenities"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.17.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
